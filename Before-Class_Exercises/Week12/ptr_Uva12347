#include <iostream>
#include <vector>
using namespace std;

vector<int> pre;
void build(int L, int R) {
    // 沒東西
    if (L > R)
        return;

    int root = pre[L];
    // 找右子樹開始位置
    int pos = L + 1;

    while (pos <= R && pre[pos] < root){//把小於root的值找出來，從index 1 開始 
        pos++;
    }
    //pos 右子樹第一個 
    // 左子樹
    build(L + 1, pos - 1);
    // 右子樹
    build(pos, R);
    // postorder
    cout << root << endl;
}
int main() {

    int x;

    while (cin >> x){
        pre.push_back(x);
    }
    build(0, pre.size() - 1);

    return 0;
}