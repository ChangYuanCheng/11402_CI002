#include <iostream>
using namespace std;

int main() {

    int T;
    cin >> T;

    while(T--) {

        int D, I;
        cin >> D >> I;

        int node = 1;

        // 走到葉節點前
        for(int level = 1; level < D; level++) {

            // 奇數 -> 左
            if(I % 2 == 1) {
                node = node * 2;
                I = (I + 1) / 2;
            }
            // 偶數 -> 右
            else {
                node = node * 2 + 1;
                I = I / 2;
            }
        }

        cout << node << "\n";
    }

    return 0;
}