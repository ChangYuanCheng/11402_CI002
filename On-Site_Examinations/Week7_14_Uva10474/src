#include <iostream>
#include <vector>
#include <algorithm>
using namespace std;

int main() {
    int N, Q;
    int caseNum = 1;

    while (cin >> N >> Q && (N || Q)) {
        vector<int> marbles(N);

        for (int i = 0; i < N; i++) {
            cin >> marbles[i];
        }

        sort(marbles.begin(), marbles.end());

        cout << "CASE# " << caseNum++ << ":" << endl;

        while (Q--) {
            int x;
            cin >> x;

            auto it = lower_bound(marbles.begin(), marbles.end(), x);

            if (it != marbles.end() && *it == x) {
                cout << x << " found at "
                     << (it - marbles.begin() + 1)
                     << endl;
            }
            else {
                cout << x << " not found" << endl;
            }
        }
    }

    return 0;
}