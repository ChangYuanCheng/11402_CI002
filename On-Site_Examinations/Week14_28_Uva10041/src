#include <iostream>
#include <vector>
#include <algorithm>
#include <cmath>
using namespace std;

int main() {
    int T;
    cin >> T;

    while (T--) {
        int r;
        cin >> r;

        vector<int> a(r);

        for (int i = 0; i < r; i++) {
            cin >> a[i];
        }

        sort(a.begin(), a.end());

        int median = a[r / 2];

        int ans = 0;

        for (int i = 0; i < r; i++) {
            ans += abs(a[i] - median);
        }

        cout << ans << endl;
    }

    return 0;
}