#include <iostream>
#include <stack>
#include <vector>
using namespace std;

int main() {
    int n;

    while (cin >> n && n) {

        while (true) {
            vector<int> target(n);

            cin >> target[0];

            if (target[0] == 0) {
                cout << endl;
                break;
            }

            for (int i = 1; i < n; i++) {
                cin >> target[i];
            }

            stack<int> st;
            int cur = 1;
            int idx = 0;

            while (cur <= n) {
                st.push(cur++);

                while (!st.empty() &&
                       st.top() == target[idx]) {
                    st.pop();
                    idx++;
                }
            }

            if (idx == n)
                cout << "Yes\n";
            else
                cout << "No\n";
        }
    }

    return 0;
}