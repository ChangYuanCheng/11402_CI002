#include <iostream>
#include <vector>
#include <string>
#include <sstream>
using namespace std;

int main() {

    long long x;
    string line;

    while (cin >> x) {

        cin.ignore();

        getline(cin, line);

        stringstream ss(line);

        vector<long long> a;
        long long num;

        while (ss >> num) {
            a.push_back(num);
        }

        int n = a.size() - 1;

        long long ans = 0;

        for (int i = 0; i < n; i++) {
            ans = ans * x + a[i] * (n - i);
        }

        cout << ans << endl;
    }

    return 0;
}
