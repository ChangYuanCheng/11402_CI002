#include <iostream>
using namespace std;

long long a[105][105];

int main() {
    int T;
    cin >> T;

    for (int tc = 1; tc <= T; tc++) {

        char ch;
        int n;
        cin >> ch >> ch >> n; // M = n

        bool ok = true;

        for (int i = 0; i < n; i++) {
            for (int j = 0; j < n; j++) {
                cin >> a[i][j];
                if (a[i][j] < 0) ok = false;
            }
        }

        for (int i = 0; i < n && ok; i++) {
            for (int j = 0; j < n && ok; j++) {
                if (a[i][j] != a[n - 1 - i][n - 1 - j]) {
                    ok = false;
                }
            }
        }

        cout << "Test #" << tc << ": ";
        if (ok) cout << "Symmetric." << endl;
        else cout << "Non-symmetric." << endl;
    }

    return 0;
}