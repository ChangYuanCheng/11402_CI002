#include <iostream>
#include <vector>
#include <algorithm>
using namespace std;

int main() {

    int n;

    while (cin >> n) {

        vector<int> a(n);

        for (int i = 0; i < n; i++) {
            cin >> a[i];
        }

        sort(a.begin(), a.end());

        int low = a[(n - 1) / 2];
        int high = a[n / 2];

        int cnt =
            upper_bound(a.begin(), a.end(), high)
            - lower_bound(a.begin(), a.end(), low);

        int ways = high - low + 1;

        cout << low
             << " "
             << cnt
             << " "
             << ways
             << endl;
    }

    return 0;
}
