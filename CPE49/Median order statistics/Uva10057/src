#include <iostream>
#include <vector>
#include <algorithm>
using namespace std;

int main() {
    int n;

    while (cin >> n) {
        vector<int> a(n);

        for (int i = 0; i < n; i++) {
            cin >> a[i];
        }

        sort(a.begin(), a.end());

        int mid1 = a[(n - 1) / 2];
        int mid2 = a[n / 2];

        int cnt = 0;

        for (int x : a) {
            if (x == mid1 || x == mid2) cnt++;
        }

        int ways = (mid2 - mid1 + 1);

        cout << mid1 << " " << cnt << " " << ways << endl;
    }

    return 0;
}