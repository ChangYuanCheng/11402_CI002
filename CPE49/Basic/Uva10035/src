#include <iostream>
#include <string>
using namespace std;

int main() {
    string a, b;

    while (cin >> a >> b) {
        if (a == "0" && b == "0") break;

        int i = a.size() - 1;
        int j = b.size() - 1;
        int carry = 0, cnt = 0;

        while (i >= 0 || j >= 0) {
            int x = (i >= 0) ? a[i] - '0' : 0;
            int y = (j >= 0) ? b[j] - '0' : 0;

            int sum = x + y + carry;

            if (sum >= 10) {
                carry = 1;
                cnt++;
            } else {
                carry = 0;
            }

            i--;
            j--;
        }

        if (cnt == 0)
            cout << "No carry operation." << endl;
        else if (cnt == 1)
            cout << "1 carry operation." << endl;
        else
            cout << cnt << " carry operations." << endl;
    }

    return 0;
}