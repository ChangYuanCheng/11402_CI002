#include<iostream>
using namespace std;

int cyc(int n ){
    int cnt = 1;
    while(n!=1){
      if(n%2==0){
        n=3*n+1;

      }
      else{
        n=n/2;
      }
      cnt++;
    }
    return cnt;
}

int main() {
    int i,j;

    while(cin >> i >>j){
       int a =i;
       int b =j;
       if(i>j){
        swap(i,j);

       }

       int max = 0;
       for(int n = i; n<=j;n++){
        int c =cyc(n);
        if(max<c){
            max = c;

        }
       }
       cout << a << " " << b << max << endl;
    }
}