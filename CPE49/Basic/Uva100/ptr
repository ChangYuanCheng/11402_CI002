#include <iostream>
using namespace std;

int count(int n) {
	int cnt = 1;
	while (n != 1) {
		if (n % 2 == 0) {
			n /= 2;

		}
		else {
			n = 3 * n + 1;
		}
		cnt++;
	}
	return cnt;
}

int main() {
	int i, j;
	while (cin >> i >> j) {
		if (i > j) {
			swap(i, j);
		}

		int max = 0;

		for (int a = i; a <= j; a++) {
			int c = count(a);
			if (max < c) {
				max = c;
			}
		}
		cout << i << " " << j << " " << max << endl;
	}

}