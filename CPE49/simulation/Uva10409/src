#include <iostream>
using namespace std;

int main() {
    int n;

    while (cin >> n && n) {

        int top = 1, bottom = 6;
        int north = 2, south = 5;
        int east = 3, west = 4;

        while (n--) {
            string s;
            cin >> s;

            int t = top;

            if (s == "north") {
                top = south;
                south = bottom;
                bottom = north;
                north = t;
            }
            else if (s == "south") {
                top = north;
                north = bottom;
                bottom = south;
                south = t;
            }
            else if (s == "east") {
                top = west;
                west = bottom;
                bottom = east;
                east = t;
            }
            else if (s == "west") {
                top = east;
                east = bottom;
                bottom = west;
                west = t;
            }
        }

        cout << top << endl;
    }

    return 0;
}