#include <iostream>
#include <vector>
using namespace std;

int dx[8] = {-1,-1,-1,0,0,1,1,1};
int dy[8] = {-1,0,1,-1,1,-1,0,1};

int main() {
    int n, m;
    int tc = 1;

    while (cin >> n >> m) {
        if (n == 0 && m == 0) break;

        vector<string> g(n);

        for (int i = 0; i < n; i++) {
            cin >> g[i];
        }

        if (tc > 1) cout << endl;

        cout << "Field #" << tc++ << ":" << endl;

        for (int i = 0; i < n; i++) {
            for (int j = 0; j < m; j++) {

                if (g[i][j] == '*') {
                    cout << "*";
                } else {
                    int cnt = 0;

                    for (int d = 0; d < 8; d++) {
                        int ni = i + dx[d];
                        int nj = j + dy[d];

                        if (ni >= 0 && ni < n && nj >= 0 && nj < m) {
                            if (g[ni][nj] == '*') cnt++;
                        }
                    }

                    cout << cnt;
                }
            }
            cout << endl;
        }
    }

    return 0;
}