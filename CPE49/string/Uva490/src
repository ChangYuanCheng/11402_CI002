#include <iostream>
#include <vector>
#include <string>
using namespace std;

int main() {

    vector<string> s;
    string line;

    int maxLen = 0;

    // 讀到 EOF
    while (getline(cin, line)) {

        s.push_back(line);

        if (line.length() > maxLen)
            maxLen = line.length();
    }

    // 旋轉輸出
    for (int i = 0; i < maxLen; i++) {

        for (int j = s.size() - 1; j >= 0; j--) {

            if (i < s[j].length())
                cout << s[j][i];
            else
                cout << ' ';
        }

        cout << endl;
    }

    return 0;
}
