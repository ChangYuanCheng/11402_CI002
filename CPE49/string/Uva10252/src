#include <iostream>
#include <string>
#include <algorithm>
using namespace std;

int main() {
    string a, b;

    while (getline(cin, a) && getline(cin, b)) {

        int ca[26] = {0};
        int cb[26] = {0};

        for (char c : a)
            if (isalpha(c))
                ca[c - 'a']++;

        for (char c : b)
            if (isalpha(c))
                cb[c - 'a']++;

        for (int i = 0; i < 26; i++) {
            int t = min(ca[i], cb[i]);
            for (int j = 0; j < t; j++)
                cout << char('a' + i);
        }

        cout << "\n";
    }

    return 0;
}