#include <iostream>
#include <string>
using namespace std;

int main() {

    string s;
    bool open = true;

    while (getline(cin, s)) {

        for (int i = 0; i < s.length(); i++) {

            if (s[i] == '"') {

                if (open)
                    cout << "``";
                else
                    cout << "''";

                open = !open;
            }
            else {
                cout << s[i];
            }
        }

        cout << endl;
    }

    return 0;
}