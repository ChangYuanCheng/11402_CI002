#include <iostream>
#include <string>
#include <algorithm>
using namespace std;

struct Letter {
    char ch;
    int cnt;
};

bool cmp(Letter a, Letter b) {

    if (a.cnt != b.cnt)
        return a.cnt > b.cnt;

    return a.ch < b.ch;
}

int main() {

    int n;
    cin >> n;
    cin.ignore();

    int freq[26] = {0};

    string s;

    while (n--) {

        getline(cin, s);

        for (int i = 0; i < s.length(); i++) {

            if (isalpha(s[i])) {

                char c = toupper(s[i]);

                freq[c - 'A']++;
            }
        }
    }

    Letter arr[26];

    for (int i = 0; i < 26; i++) {
        arr[i].ch = 'A' + i;
        arr[i].cnt = freq[i];
    }

    sort(arr, arr + 26, cmp);

    for (int i = 0; i < 26; i++) {

        if (arr[i].cnt > 0) {
            cout << arr[i].ch
                 << " "
                 << arr[i].cnt
                 << endl;
        }
    }

    return 0;
}
